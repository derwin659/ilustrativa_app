FROM python:3.11-slim-bookworm

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1     PIP_DISABLE_PIP_VERSION_CHECK=1     HF_HOME=/runpod-volume/huggingface     SD_MODEL=/runpod-volume/models/sd15     CONTROLNET_MODEL=/runpod-volume/models/controlnet-canny     LORA_MID_FADE_PATH=/runpod-volume/loras/mid_fade_sd15.safetensors     REQUIRE_LORA=true REQUIRE_GPU=true MODEL_LOCAL_FILES_ONLY=true

RUN apt-get update && apt-get install -y --no-install-recommends     build-essential libglib2.0-0 libgl1     && rm -rf /var/lib/apt/lists/*

# Cache completed downloads across failed builds; keep CUDA in its own layer.
RUN --mount=type=cache,id=supergods-pip-cu124,target=/root/.cache/pip pip install --retries 10 --timeout 60 pip==25.2
RUN --mount=type=cache,id=supergods-pip-cu124,target=/root/.cache/pip pip install --retries 10 --timeout 60 --resume-retries 10 torch==2.6.0 --index-url https://download.pytorch.org/whl/cu124

COPY requirements-serverless.txt .
RUN --mount=type=cache,id=supergods-pip-cu124,target=/root/.cache/pip pip install --retries 10 --timeout 60 --resume-retries 10 -r requirements-serverless.txt && pip check && pip freeze > /app/installed-requirements.txt

# Copy runtime code only: never training photos, generated images or local credentials.
COPY services/ ./services/
COPY schemas_runpod.py handler.py worker_startup.py ./
COPY tests/ ./tests/

RUN python -m compileall -q services schemas_runpod.py handler.py worker_startup.py     && python -c "import torch, diffusers, transformers, peft, cloudinary, runpod; from diffusers import StableDiffusionInpaintPipeline, StableDiffusionControlNetInpaintPipeline; print('Runtime imports OK; CUDA build:', torch.version.cuda)"     && python -m unittest discover -s tests -v

CMD ["python", "handler.py"]